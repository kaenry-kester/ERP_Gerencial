# Copie para ".env" e preencha. O .env não vai para o Git (tem a senha do banco).

# Conexão com o PostgreSQL do Órion
ORION_BANCO=host=localhost port=5432 dbname=orion user=postgres password=SUA_SENHA

# web = envia de verdade pelo WhatsApp Web | teste = só registra no histórico, nada sai
WHATSAPP_MODO=web

# De quantos em quantos segundos o robô verifica o banco
VERIFICAR_A_CADA_SEGUNDOS=60
