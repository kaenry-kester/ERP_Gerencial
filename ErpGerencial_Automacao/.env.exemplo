# Copie para ".env" e preencha. Usado só pelos comandos "conectar" e "testar" do lembretes.py
# (o envio automático é feito pela API; a configuração dele fica em Orion.Api/appsettings.json, seção EnvioAutomatico).

# Evolution API: endereço e chave (a mesma AUTHENTICATION_API_KEY do evolution-api/.env)
EVOLUTION_URL=http://localhost:8080
EVOLUTION_CHAVE=COLOQUE_A_MESMA_CHAVE_DO_EVOLUTION
