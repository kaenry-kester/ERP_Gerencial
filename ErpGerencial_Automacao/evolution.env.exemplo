# Configuração da Evolution API para o Órion.
# Copie para "evolution-api/.env", troque SUA_SENHA e invente uma chave (letras e números, 32 caracteres).
# A mesma chave vai em EVOLUTION_CHAVE no .env do robô.
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080
TELEMETRY_ENABLED=false
CORS_ORIGIN=*
LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=true
LOG_BAILEYS=error
DEL_INSTANCE=false
# Banco "evolution" no mesmo PostgreSQL do Órion (crie antes: CREATE DATABASE evolution;)
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://postgres:SUA_SENHA@localhost:5432/evolution?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=orion
# Guarda só o login de cada celular, não as conversas
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
RABBITMQ_ENABLED=false
SQS_ENABLED=false
WEBSOCKET_ENABLED=false
CONFIG_SESSION_PHONE_CLIENT=Orion
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
# Sem Redis: cache na memória
CACHE_REDIS_ENABLED=false
CACHE_LOCAL_ENABLED=true
AUTHENTICATION_API_KEY=INVENTE_UMA_CHAVE
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true
LANGUAGE=pt-BR
